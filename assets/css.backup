/* Replaced with lil-fluff theme styles */
:root{
  --bg:#0b0b0b;
  --panel:#111;
  --muted:#222;
  --violet:#8A2BE2;
  --blue:#00BFFF;
  --accent-glow: 0 0 12px rgba(138,43,226,0.6), 0 0 30px rgba(0,191,255,0.15);
}
*{box-sizing:border-box}
html,body{height:100%}
body{
  margin:0;padding:18px;font-family:'Roboto Mono',monospace;background:linear-gradient(180deg,var(--bg),#070708);color:var(--blue);-webkit-font-smoothing:antialiased;}
a{color:var(--violet);text-decoration:none}
.container{max-width:1100px;margin:0 auto; display:flex; flex-direction:column; min-height:100vh;}
/* Ensure main grows to fill available space so footer sits at the bottom */
main{flex:1; display:flex; align-items:center; justify-content:center; padding:18px 0;}
/* Header / Nav */
.header{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 0}
.brand{display:flex;align-items:center;gap:12px}
.brand img{width:56px;height:56px;border-radius:12px;box-shadow:var(--accent-glow)}
.site-title{font-family:'Orbitron',sans-serif;font-weight:700;color:var(--violet);font-size:1.25rem;text-shadow:0 0 10px rgba(138,43,226,0.6)}
.nav{display:flex;gap:10px;align-items:center}
.nav a{padding:8px 12px;border-radius:8px;border:1px solid rgba(138,43,226,0.12);background:rgba(255,255,255,0.02);box-shadow:0 0 6px rgba(0,191,255,0.04)}
.nav a:hover{box-shadow:var(--accent-glow);transform:translateY(-2px)}
.h1{font-family:'Orbitron',sans-serif;font-size:2rem;color:var(--violet);text-shadow:0 0 18px rgba(138,43,226,0.6);}
.tagline{color:#cfefff;opacity:0.95}
.btn{padding:10px 16px;border-radius:12px;border:1px solid rgba(255,255,255,0.06);background:linear-gradient(180deg,rgba(255,255,255,0.02),rgba(255,255,255,0.01));cursor:pointer}
.btn.primary{background:linear-gradient(180deg,var(--violet),#6f1adf);color:#fff;box-shadow:var(--accent-glow)}
.btn.ghost{border:1px dashed rgba(0,191,255,0.18);color:var(--blue);}
/* Sections */
.section{background:linear-gradient(180deg,rgba(255,255,255,0.01),transparent);border:1px solid rgba(255,255,255,0.03);padding:18px;border-radius:12px;margin:18px auto;width:75vw;max-width:1000px}
/* Glitch animation */
@keyframes glitch{0%{opacity:1;transform:translateY(0)}10%{opacity:.9;transform:translateY(-1px)}20%{opacity:1;transform:translateY(1px)}100%{opacity:1}}
.heading-glitch{animation:glitch 3s infinite}
/* Footer */
.footer{padding:18px 0;text-align:center;color:#9fbfdc}
/* Utility */
.small{font-size:0.9rem;color:#9fbfdc}
/* Neon link */
.neon{color:var(--violet);text-shadow:0 0 8px rgba(138,43,226,0.6)}